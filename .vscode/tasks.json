{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db",
      "type": "shell",
      "command": "docker compose up -d db",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "backend",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOn": "db",
      "isBackground": true,
      "problemMatcher": {
        "owner": "backend",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": ".",
          "endsPattern": "Backend listening|EADDRINUSE"
        }
      }
    },
    {
      "label": "frontend",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": ".",
          "endsPattern": "Local:|already in use"
        }
      }
    },
    {
      "label": "dev: all",
      "dependsOn": ["backend", "frontend"],
      "problemMatcher": []
    }
  ]
}
